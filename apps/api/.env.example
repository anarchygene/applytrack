# Copy to .env for local development. Never commit real secrets.

# PostgreSQL connection (docker compose exposes Postgres on 5433)
DATABASE_URL=postgres://applytrack:applytrack@localhost:5433/applytrack
# Optional direct (non-pooled) connection used only for migrations, e.g. Neon's URL without
# "-pooler" in the hostname. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Used only by the test suite; it is truncated between tests
TEST_DATABASE_URL=postgres://applytrack:applytrack@localhost:5433/applytrack_test

PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Send session cookies only over HTTPS (true in production)
COOKIE_SECURE=false

# Optional: enables AI resume tailoring. Leave empty to disable.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5. Set claude-haiku-5-5 for a much cheaper public demo.
ANTHROPIC_MODEL=claude-opus-5-5
# Allow temporary demo accounts to use AI tailoring (costs the operator money)
AI_ALLOW_DEMO=false

# Directory of the built web app to serve (production only)
WEB_DIST_DIR=

# Apply pending migrations on startup (used on Render free tier)
MIGRATE_ON_START=false
